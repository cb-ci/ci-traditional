
# CloudBees CI Versions & Images
export CB_VERSION=latest
export DOCKER_IMAGE_CJOC=cloudbees/cloudbees-core-oc:${CB_VERSION}
export DOCKER_IMAGE_CONTROLLER=cloudbees/cloudbees-core-cm:${CB_VERSION}
export DOCKER_IMAGE_HAPROXY=haproxy:3.1.13

# Hostnames & URLs
export CJOC_URL=cjoc.local
export CONTROLLER_URL=controller.local

# Credentials
export CJOC_LOGIN_USER=admin
export CJOC_LOGIN_PW=admin


# File Paths (Persistence)
export JENKINS_HOME_CONTAINER=/var/jenkins_home
export LOCAL_VOLUME=${PWD}/data
export CJOC_PERSISTENCE=${LOCAL_VOLUME}/jenkins-home-oc
export CJOC_CASC_BUNDLE_PATH_LOCAL=${PWD}/casc/cjoc
export CONTROLLER_BUNDLE_NAME=controller
export CJOC_CASC_DEFAULT_BUNDLE=local/${CONTROLLER_BUNDLE_NAME}
export CONTROLLER_PERSISTENCE=${LOCAL_VOLUME}/jenkins-home-${CONTROLLER_BUNDLE_NAME}
export CONTROLLER_CACHE=${LOCAL_VOLUME}/jenkins-cache-${CONTROLLER_BUNDLE_NAME}
export CONTROLLER_CASC_BUNDLE_PATH_LOCAL=${PWD}/casc/${CONTROLLER_BUNDLE_NAME}
export HA_PROXY_CONFIG=${PWD}/haproxy-config/gen-haproxy-ssl.cfg
export CASC_BUNDLE_PATH_CONTAINER=/tmp/cascbundle
export SECRET_PATH_CJOC_TOKEN=/var/secrets/cjoc_token.txt


# Java & Jenkins Options
export COMMON_JAVA_OPTS="-XX:+AlwaysPreTouch 
    -XX:+UseStringDeduplication 
    -XX:+ParallelRefProcEnabled 
    -XX:+DisableExplicitGC 
    -Xmx2g -Djava.awt.headless=true 
    -Dcom.cloudbees.jenkins.ha=false 
    -Djenkins.model.Jenkins.crumbIssuerProxyCompatibility=true 
    -DexecutableWar.jetty.disableCustomSessionIdCookieName=true     
    -Djavax.net.ssl.trustStore=/tmp/cacerts 
    -Djavax.net.ssl.trustStorePassword=changeit 
    -Djavax.net.ssl.trustStoreType=PKCS12
    "
export CJOC_JAVA_OPTS="${COMMON_JAVA_OPTS} -Dcore.casc.config.bundle=${CASC_BUNDLE_PATH_CONTAINER}/cjoc"
export CJOC_JENKINS_OPTS=""
export CONTROLLER_JAVA_OPTS="${COMMON_JAVA_OPTS} -Dcore.casc.config.bundle=${JENKINS_HOME_CONTAINER}/bundle-link.yaml"
export CONTROLLER_JENKINS_OPTS=""

# Networking

export HTTP_PROTOCOL=https
export HTTP_PORT=8080
export HA_PROXY_BIND_PORT=443
export IP_PREFIX=172.47
export HAPROXY_IP=${IP_PREFIX}.0.2
export CJOC_IP=${IP_PREFIX}.0.6
export CONTROLLER_IP=${IP_PREFIX}.0.5
export BROWSER_IP=${IP_PREFIX}.0.8
export INIT_CLIENT_IP=${IP_PREFIX}.0.9


